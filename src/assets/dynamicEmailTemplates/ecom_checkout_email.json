  "html": "<!-- Checkout Email - Transactional Confirmation Style -->\n\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <meta name=\"x-apple-disable-message-reformatting\" />\n  <title>Complete Your Checkout - Secure Payment</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #f8fafc;\">\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 0; padding: 0; width: 100%; background-color: #f8fafc;\" role=\"presentation\">\n    <tr>\n      <td align=\"center\" style=\"padding: 20px 0;\">\n        \n        <!-- Main Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);\" role=\"presentation\">\n          \n          <!-- Component start Header -->\n          <tr>\n            <td align=\"center\" style=\"padding: 30px 20px; background-color: #ffffff; border-radius: 8px 8px 0 0;\">\n              <img src=\"https://via.placeholder.com/180x60/1e40af/ffffff?text=SHOPPING\" alt=\"Shopping Cart\" width=\"180\" height=\"60\" style=\"display: block; width: 180px; height: 60px; margin: 0 auto 20px; border: 0;\" />\n              <h1 style=\"margin: 0 0 10px 0; padding-bottom: 0; color: #1e293b; font-size: 28px; font-weight: 700; line-height: 34px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Complete Your Checkout</h1>\n            </td>\n          </tr>\n          <!-- Component end Header -->\n          \n          <!-- Component start Cart Summary -->\n          <tr>\n            <td style=\"padding: 30px 20px; background-color: #ffffff;\">\n              <h2 style=\"margin: 0 0 25px 0; padding-top: 0; padding-bottom: 0; color: #1f2937; font-size: 20px; font-weight: 600; line-height: 26px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Your Order Summary</h2>\n              \n              <!-- Item 1 -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\"><tr><td style=\"border-radius: 8px; padding: 20px; margin-bottom: 15px;\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                  <tr>\n                    <td width=\"120\" style=\"padding-right: 15px;\">\n                      <!--[if mso]>\n                      <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" style=\"height:120px;v-text-anchor:middle;width:120px;\" arcsize=\"7%\" stroke=\"f\" fillcolor=\"#ffffff\">\n                        <w:anchorlock/>\n                        <v:imagedata src=\"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=150&q=80\" />\n                      </v:roundrect>\n                      <![endif]-->\n                      <!--[if !mso]> -->\n                      <img data-element=\"logo\"  src=\"https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=150&q=80\" alt=\"Wireless Headphones\" width=\"120\" style=\"display: block; width: 120px; height: 120px; border-radius: 6px; border: 0;\" />\n                      <!--<![endif]-->\n                    </td>\n                    <td valign=\"top\">\n                      <h3 data-element=\"product-1-name\" style=\"margin: 0 0 8px 0; color: #1e293b; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Premium Wireless Headphones</h3>\n                      <p data-element=\"product-1-description\" style=\"margin: 0 0 8px 0; color: #64748b; font-size: 14px; line-height: 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Color: Black • Qty: 1</p>\n                      <!--[if mso]>\n                      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                        <tr>\n                          <td align=\"center\">\n                            <p style=\"margin: 0; color: #1e293b; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$199.99</p>\n                          </td>\n                        </tr>\n                      </table>\n                      <![endif]-->\n                      <!--[if !mso]> -->\n                      <p data-element=\"product-1-price\" style=\"margin: 0; color: #1e293b; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: left;\">$199.99</p>\n                      <!--<![endif]-->\n                    </td>\n                  </tr>\n                </table>\n              </td></tr></table>\n              \n              <!-- Order Total -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\"><tr><td style=\"display: table-cell !important; background-color: #ffffff; border-radius: 8px; padding: 20px;\">\n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                  <tr>\n                    <td style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Subtotal:</td>\n                    <!--[if mso]>\n                    <td align=\"center\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$199.99</td>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <td align=\"right\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: right; width: auto;\"><span data-element=\"subtotal-amount\" style=\"display: inline;\">$199.99</span></td>\n                    <!--<![endif]-->\n                  </tr>\n                  <tr>\n                    <td style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Shipping:</td>\n                    <!--[if mso]>\n                    <td align=\"center\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$9.99</td>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <td align=\"right\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: right; width: auto;\"><span data-element=\"shipping-amount\" style=\"display: inline;\">$9.99</span></td>\n                    <!--<![endif]-->\n                  </tr>\n                  <tr>\n                    <td style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Tax:</td>\n                    <!--[if mso]>\n                    <td align=\"center\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$16.00</td>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <td align=\"right\" style=\"display: table-cell !important; padding: 5px 0; color: #64748b; font-size: 16px; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: right; width: auto;\"><span data-element=\"tax-amount\" style=\"display: inline;\">$16.00</span></td>\n                    <!--<![endif]-->\n                  </tr>\n                  <tr style=\"border-top: 2px solid #e2e8f0;\">\n                    <td style=\"display: table-cell !important; padding: 10px 0 5px 0; color: #1f2937; font-size: 20px; font-weight: 700; line-height: 26px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Total:</td>\n                    <!--[if mso]>\n                    <td align=\"center\" style=\"display: table-cell !important; padding: 10px 0 5px 0; color: #1f2937; font-size: 20px; font-weight: 700; line-length: 26px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$225.98</td>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <td align=\"right\" style=\"display: table-cell !important; padding: 10px 0 5px 0; color: #1f2937; font-size: 20px; font-weight: 700; line-height: 26px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-align: right; width: auto;\"><span data-element=\"total-amount\" style=\"display: inline;\">$225.98</span></td>\n                    <!--<![endif]-->\n                  </tr>\n                </table>\n              </td></tr></table>\n            </td>\n          </tr>\n          \n          <!-- Spacing between cart summary and checkout CTA -->\n          <!--[if mso]>\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n            <tr>\n              <td style=\"height: 30px; line-height: 30px; font-size: 1px;\">&nbsp;</td>\n            </tr>\n          </table>\n          <![endif]-->\n          <!--[if !mso]> -->\n          <div style=\"height: 30px; line-height: 30px; font-size: 1px;\">&nbsp;</div>\n          <!--<![endif]-->\n          <!-- Component end Cart Summary -->\n          \n          <!-- Component start Checkout CTA -->\n          <tr>\n            <td style=\"padding: 30px 20px; background-color: #ffffff;\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\"><tr><td style=\"text-align: center; margin-bottom: 25px;\">\n                <h3 data-element=\"checkout-cta-heading\" style=\"margin: 0 0 15px 0; color: #1f2937; font-size: 20px; font-weight: 600; line-height: 26px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Ready to check out</h3>\n                <p data-element=\"checkout-subheading\" style=\"margin: 0; color: #64748b; line-height: 22px; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Complete your secure payment in just a few clicks</p>\n              </td></tr></table>\n              \n              <br />\n              <!--[if !mso]> -->\n              <br />\n              <!--<![endif]-->\n              <!--[if mso]>\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"margin-bottom: 25px;\">\n                    <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"#\" style=\"height:60px;v-text-anchor:middle;width:200px;\" arcsize=\"10%\" stroke=\"f\" fillcolor=\"#1e40af\">\n                      <w:anchorlock/>\n                      <center style=\"color:#ffffff;font-family:Segoe UI, Roboto, sans-serif;font-size:18px;font-weight:700;\">\n                        Complete checkout\n                      </center>\n                    </v:roundrect>\n                  </td>\n                </tr>\n              </table>\n              <![endif]-->\n              <!--[if !mso]> -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\"><tr><td style=\"text-align: center; margin-bottom: 25px;\">\n                <a data-element=\"checkout-button\" href=\"#\" style=\"display: inline-block; padding: 18px 40px; background-color: #1e40af; color: #ffffff; text-decoration: none; border-radius: 8px; border: 0; font-weight: 700; font-size: 18px; line-height: 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Complete checkout</a>\n              </td></tr></table>\n              <!--<![endif]-->\n              \n            </td>\n          </tr>\n          <!-- Component end Checkout CTA -->\n          \n                    <!-- Component start Footer -->\n          <!-- Footer Option 2: Standard Footer with Company Info, Links, and Social Media -->\n          <tr>\n            <td align=\"center\" style=\"padding: 40px 20px 30px 20px; background-color: #ffffff; border-radius: 0 0 8px 8px;\">\n              \n              <!-- Divider -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td style=\"padding: 0 0 30px 0; border-top: 1px solid #e2e8f0;\"></td>\n                </tr>\n              </table>\n              \n              <!-- Company Name / Brand -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 15px 0;\">\n                    <p data-element=\"footer-company-name\" style=\"margin: 0; color: #1e293b; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Your Company Name</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Company Address (CAN-SPAM Compliance) -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <p data-element=\"footer-address\" style=\"margin: 0; color: #64748b; font-size: 12px; line-height: 18px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">123 Main Street<br />City, State 12345<br />United States</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Trust Indicators / Tagline -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 25px 0;\">\n                    <p data-element=\"footer-tagline\" style=\"margin: 0; color: #64748b; font-size: 12px; line-height: 18px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Secure checkout • Fast delivery • Easy returns</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Social Media Links -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 25px 0;\">\n                    <!--[if mso]>\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Facebook</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Twitter</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Instagram</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">LinkedIn</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-facebook\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Facebook</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-twitter\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Twitter</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-instagram\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Instagram</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-linkedin\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">LinkedIn</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <!--<![endif]-->\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Legal & Support Links -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <!--[if mso]>\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                      <tr>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Privacy Policy</a>\n                        </td>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Terms of Service</a>\n                        </td>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Help Center</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Unsubscribe</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-privacy\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Privacy Policy</a>\n                        </td>\n                        <td id=\"link_2_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-terms\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Terms of Service</a>\n                        </td>\n                        <td id=\"link_3_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-help\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Help Center</a>\n                        </td>\n                        <td id=\"link_4_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-unsubscribe\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Unsubscribe</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <!--<![endif]-->\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Social Icons (customizable – replace emoji with your icon) -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-1\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">📘</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-2\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">🐦</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-3\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">📷</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-4\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">💼</a></td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Contact Information -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 15px 0;\">\n                    <p data-element=\"footer-contact\" style=\"margin: 0; color: #64748b; font-size: 11px; line-height: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Questions? Contact us at <a href=\"mailto:support@yourcompany.com\" style=\"color: #2563eb; text-decoration: underline;\">support@yourcompany.com</a></p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Copyright -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0;\">\n                    <p data-element=\"footer-copyright\" style=\"margin: 0; color: #94a3b8; font-size: 11px; line-height: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">©YYYY Your Company Name. All rights reserved.</p>\n                  </td>\n                </tr>\n              </table>\n              \n            </td>\n          </tr>\n          <!-- Component end Footer -->\n          \n        </table>\n        <!-- End Main Container -->\n        \n      </td>\n    </tr>\n  </table>\n  <!-- End Wrapper -->\n</body>\n</html>\n",
  "elements": [
    {
