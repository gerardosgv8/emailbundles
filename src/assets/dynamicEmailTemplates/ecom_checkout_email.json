      "selector": "h1",
      "label": "Main Heading ",
      "defaultValue": "Complete Your Checkout",
      "value": "Complete Your Checkout",
      "visible": true,
      "properties": {
        "fontSize": "32px",
        "textColor": "#1e293b",
        "paddingTop": "0px",
