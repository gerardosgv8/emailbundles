  "html": "<!-- Survey/Feedback Email - Data Collection Focused -->\n\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <meta name=\"x-apple-disable-message-reformatting\" />\n  <title>Help Us Improve - Quick 2-Minute Survey</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #f8fafc;\">\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 0; padding: 0; width: 100%; background-color: #f8fafc;\" role=\"presentation\">\n    <tr>\n      <td align=\"center\" style=\"padding: 20px 0;\">\n        \n        <!-- Main Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);\" role=\"presentation\">\n          \n          <!-- Component start Header -->\n          <tr>\n            <td align=\"center\" style=\"padding: 40px 30px; background-color: #ffffff; border-radius: 12px 12px 0 0;\">\n              <!--[if mso | IE]><br /><![endif]-->\n              <img src=\"https://via.placeholder.com/180x60/2563eb/ffffff?text=FEEDBACK\" alt=\"Feedback Logo\" width=\"180\" height=\"60\" style=\"display: block; width: 180px; height: 60px; margin: 0 auto 20px; border: 0;\" data-element=\"logo\" />\n              <!--[if mso | IE]><br /><![endif]-->\n                            <h1 data-element=\"header-title\" style=\"margin: 0 0 15px 0; color: #1e293b; font-size: 32px; font-weight: 700; line-height: 38px; font-family: -apple-system, BlinkMacSystemFont, \\'Segoe UI\\', Roboto, sans-serif; padding-bottom: 0 !important;\">Help Us Improve</h1>\n            </td>\n          </tr>\n          <!-- Component end Header -->\n          <!-- Component start Main Content -->\n          <!-- Main Content -->\n          <tr>\n            <td style=\"padding: 0 30px 40px 30px; background-color: #ffffff;\">\n              <div style=\"text-align: center; margin-bottom: 40px;\">\n                  <p data-element=\"survey-description\" style=\"margin: 0; color: #64748b; line-height: 26px; font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, \\'Segoe UI\\', Roboto, sans-serif; padding-top: 0 !important; padding-bottom: 0 !important;\">Hi there! We\\'d love to hear about your recent experience with us. Your honest feedback helps us improve our products and services for everyone.</p>\n              </div>\n              \n              \n              <!-- Incentive -->\n              \n              <!-- Main CTA -->\n              <!--[if mso | IE]><br /><![endif]-->\n              <div style=\"text-align: center; margin: 40px 0;\">\n                <a data-element=\"survey-cta\" href=\"#\" style=\"display: inline-block; padding: 18px 36px; background-color: #2563eb; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 18px; line-height: 24px; font-family: -apple-system, BlinkMacSystemFont, \\'Segoe UI\\', Roboto, sans-serif;\">Take Survey (2 min)</a>\n              </div>\n              <!--[if mso | IE]><br /><![endif]-->\n              \n              <!-- Privacy Note -->\n            </td>\n          </tr>\n          <!-- Component end Main Content -->\n                    <!-- Component start Footer -->\n          <!-- Footer Option 2: Standard Footer with Company Info, Links, and Social Media -->\n          <tr>\n            <td align=\"center\" style=\"padding: 40px 20px 30px 20px; background-color: #ffffff; border-radius: 0 0 8px 8px;\">\n              \n              <!-- Divider -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td style=\"padding: 0 0 30px 0; border-top: 1px solid #e2e8f0;\"></td>\n                </tr>\n              </table>\n              \n              <!-- Company Name / Brand -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 15px 0;\">\n                    <p data-element=\"footer-company-name\" style=\"margin: 0; color: #1e293b; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Your Company Name</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Company Address (CAN-SPAM Compliance) -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <p data-element=\"footer-address\" style=\"margin: 0; color: #64748b; font-size: 12px; line-height: 18px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">123 Main Street<br />City, State 12345<br />United States</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Trust Indicators / Tagline -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 25px 0;\">\n                    <p data-element=\"footer-tagline\" style=\"margin: 0; color: #64748b; font-size: 12px; line-height: 18px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Secure checkout • Fast delivery • Easy returns</p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Social Media Links -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 25px 0;\">\n                    <!--[if mso]>\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Facebook</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Twitter</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">Instagram</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #64748b; text-decoration: none; font-size: 12px;\">LinkedIn</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-facebook\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Facebook</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-twitter\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Twitter</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-instagram\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Instagram</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-social-linkedin\" href=\"#\" style=\"display: inline-block; color: #64748b; text-decoration: none; font-size: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">LinkedIn</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <!--<![endif]-->\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Legal & Support Links -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <!--[if mso]>\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n                      <tr>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Privacy Policy</a>\n                        </td>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Terms of Service</a>\n                        </td>\n                        <td style=\"padding: 0 8px; border-right: 1px solid #e2e8f0;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Help Center</a>\n                        </td>\n                        <td style=\"padding: 0 8px;\">\n                          <a href=\"#\" style=\"color: #2563eb; text-decoration: underline; font-size: 11px;\">Unsubscribe</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <![endif]-->\n                    <!--[if !mso]> -->\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-privacy\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Privacy Policy</a>\n                        </td>\n                        <td id=\"link_2_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-terms\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Terms of Service</a>\n                        </td>\n                        <td id=\"link_3_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-help\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Help Center</a>\n                        </td>\n                        <td id=\"link_4_separator\" style=\"padding: 0 8px; color: #e2e8f0;\">|</td> <td style=\"padding: 0 8px;\">\n                          <a data-element=\"footer-link-unsubscribe\" href=\"#\" style=\"display: inline-block; color: #2563eb; text-decoration: underline; font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Unsubscribe</a>\n                        </td>\n                      </tr>\n                    </table>\n                    <!--<![endif]-->\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Social Icons (customizable – replace emoji with your icon) -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 20px 0;\">\n                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"margin: 0 auto;\">\n                      <tr>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-1\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">📘</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-2\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">🐦</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-3\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">📷</a></td>\n                        <td style=\"padding: 0 10px;\"><a data-element=\"footer-icon-4\" href=\"#\" style=\"display: inline-block; font-size: 24px; line-height: 1; text-decoration: none;\">💼</a></td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Contact Information -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0 0 15px 0;\">\n                    <p data-element=\"footer-contact\" style=\"margin: 0; color: #64748b; font-size: 11px; line-height: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Questions? Contact us at <a href=\"mailto:support@yourcompany.com\" style=\"color: #2563eb; text-decoration: underline;\">support@yourcompany.com</a></p>\n                  </td>\n                </tr>\n              </table>\n              \n              <!-- Copyright -->\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td align=\"center\" style=\"padding: 0;\">\n                    <p data-element=\"footer-copyright\" style=\"margin: 0; color: #94a3b8; font-size: 11px; line-height: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">©YYYY Your Company Name. All rights reserved.</p>\n                  </td>\n                </tr>\n              </table>\n              \n            </td>\n          </tr>\n          <!-- Component end Footer -->\n        </table>\n        <!-- End Main Container -->\n        \n      </td>\n    </tr>\n  </table>\n  <!-- End Wrapper -->\n</body>\n</html>\n",
