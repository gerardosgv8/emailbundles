  "html": "<!-- Promotional Email 1 - Sale Announcement -->\n\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <meta name=\"x-apple-disable-message-reformatting\" />\n  <title>MEGA SALE - Up to 70% Off Everything!</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, sans-serif; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; background-color: #ffffff;\">\n  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 0; padding: 0; width: 100%; background-color: #ffffff;\" role=\"presentation\">\n    <tr>\n      <td align=\"center\" style=\"padding: 20px 0;\">\n        \n        <!-- Main Container -->\n        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 8px; overflow: hidden;\" role=\"presentation\">\n          \n          <!-- Component start Urgent Banner -->\n          <!-- Component start Header -->\n          <tr>\n            <td align=\"center\" style=\"padding: 30px 20px; background-color: #ffffff;\">\n              <p data-element=\"header-sale-banner\" style=\"margin: 0 0 15px 0; color: #dc2626; font-size: 16px; font-weight: 700; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; text-transform: uppercase; letter-spacing: 1px;\">🔥 MEGA SALE - LIMITED TIME ONLY 🔥</p>\n              <!--[if mso | IE]><br /><![endif]-->\n              <img src=\"https://via.placeholder.com/180x60/000000/ffffff?text=MEGASALE\" alt=\"Mega Sale\" width=\"180\" height=\"60\" style=\"display: block; width: 180px; height: 60px; margin: 0 auto 20px; border: 0;\" />\n              <!--[if mso | IE]><br /><![endif]-->\n              <h1 data-element=\"hero-badge\" style=\"margin: 0 0 10px 0; color: #dc2626; font-size: 48px; font-weight: 900; line-height: 54px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">70% OFF</h1>\n              <h2 data-element=\"hero-heading\" style=\"margin: 0; color: #1e293b; font-size: 28px; font-weight: 700; line-height: 34px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">EVERYTHING!</h2>\n            </td>\n          </tr>\n          <!-- Component end Header -->\n          <!-- Spacing after Header -->\n          <!--[if mso]>\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n            <tr>\n              <td style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</td>\n            </tr>\n          </table>\n          <![endif]-->\n          <!--[if !mso]> -->\n          <div style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</div>\n          <!--<![endif]-->\n          \n          <!-- Component start Hero Image -->\n          <tr>\n            <td style=\"padding: 0;\">\n              <img src=\"https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600&q=80\" alt=\"Mega Sale Products\" width=\"600\" height=\"300\" style=\"display: block; width: 100%; max-width: 600px; height: 300px; object-fit: cover; border: 0;\" />\n            </td>\n          </tr>\n\n          \n          <!-- Spacing after Hero Image -->\n          <!--[if mso]>\n          <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n            <tr>\n              <td style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</td>\n            </tr>\n          </table>\n          <![endif]-->\n          <!--[if !mso]> -->\n          <div style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</div>\n          <!--<![endif]-->\n          <!-- Component end Hero Image -->\n          <!-- Component start Sale Details -->\n          <!-- Sale Details -->\n          <tr>\n            <td style=\"padding: 40px 20px; background-color: #ffffff;\">\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\"><tr><td style=\"text-align: center; margin-bottom: 30px;\">\n                <h2 data-element=\"sale-hero-heading\" style=\"margin: 0 0 15px 0; color: #1e293b; font-size: 28px; font-weight: 700; line-height: 34px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Don't Miss This Epic Sale!</h2>\n                <p data-element=\"sale-hero-description\" style=\"margin: 0 0 25px 0; color: #64748b; line-height: 26px; font-size: 18px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Our biggest sale of the year is here! Save up to 70% on thousands of products across all categories. Limited time offer - don't wait!</p>\n              </td></tr></table>\n              \n              \n              <!-- Featured Products -->\n              <!-- Spacing before Featured Products -->\n              <!--[if mso]>\n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                <tr>\n                  <td style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</td>\n                </tr>\n              </table>\n              <![endif]-->\n              <!--[if !mso]> -->\n              <div style=\"height: 25px; line-height: 25px; font-size: 1px;\">&nbsp;</div>\n              <!--<![endif]-->\n              \n              <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 20px 0;\" role=\"presentation\">\n                  <tr>\n                    <!-- Product 1 -->\n                    <td width=\"45%\" valign=\"top\">\n                      <!--[if mso]>\n                      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                        <tr>\n                          <td align=\"center\">\n                            <v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" style=\"height:180px;v-text-anchor:middle;width:270px;\" arcsize=\"2%\" stroke=\"f\" fillcolor=\"#ffffff\">\n                              <w:anchorlock/>\n                              <v:imagedata src=\"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=270&h=180&fit=crop&q=80\" crop=\"true\" />\n                            </v:roundrect>\n                          </td>\n                        </tr>\n                      </table>\n                      <![endif]-->\n                      <!--[if !mso]> -->\n                      <img data-element=\"logo\"  src=\"https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=270&h=180&fit=crop&q=80\" alt=\"Wireless Speaker\" width=\"270\" height=\"180\" style=\"display: block; width: 270px; height: 180px; object-fit: cover; border-radius: 6px; border: 0; margin-bottom: 15px;\" />\n                      <!--<![endif]-->\n                      <h4 data-element=\"deal-1-title\" style=\"margin: 0 0 8px 0; color: #1a1a1a; font-size: 16px; font-weight: 600; line-height: 22px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">Wireless Bluetooth Speaker</h4>\n                      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\">\n                        <tr>\n                          <td style=\"margin: 8px 0;\">\n                            <span data-element=\"deal-1-price\" style=\"color: #1f2937; font-size: 18px; font-weight: 700; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\">$47.99</span>\n                            <span data-element