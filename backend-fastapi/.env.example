# EmailBundles Backend Environment Variables

# Database Connection
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Secret
SECRET_KEY=GENERATE_A_SECURE_RANDOM_STRING

# Email Alerts Provider
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL="EmailBundles Support <support@yourdomain.com>"
APP_PUBLIC_NAME=MailcraftStudio
